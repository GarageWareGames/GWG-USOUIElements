:root {
}

.uso-collapsable-control-bar {
    padding-right: 5px;
}

.uso-collapsable-control-bar-vertical {
    flex-direction: column;
    max-width: 20px;
    min-width: 20px;
    min-height: 100%;
}

.uso-collapsable-control-bar-horizontal {
    flex-direction: row;
}

.uso-collapsable-control-bar-horizontalreversed {
    flex-direction: row;
}

.uso-collapsable-content {
    transition-property: min-width, min-height;
    transition-duration: 2s;
    transition-timing-function: ease-in-out-sine;
    min-width: 0;
    min-height: 0;
}
