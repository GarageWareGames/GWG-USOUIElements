:root {
    /* Uso Line Item */
    --uso-line-item--indicator-width: 6px;
    --uso-line-item--indicator-color: rgba(69, 69, 69, 1);
}

.uso-line-item-label {
    padding-left: 1px;
    border-left-width: 3px;
    border-left-color: initial;
}
.uso-line-item {
     display: flex;
     flex-grow: 0;
     flex-shrink: 0;
     width: 100%;
     align-items: flex-start;
     justify-content: flex-start;
 }

.uso-line-item--indicator {
    width: var(--uso-line-item--indicator-width);
    height: 100%;
    background-color: var(--uso-line-item--indicator-color);
    margin-right: 1px;
}