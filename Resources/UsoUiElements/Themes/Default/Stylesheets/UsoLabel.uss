:root {
    /* Uso Label */
    --uso-label-font-size: var(--uso-font-size);
    --uso-label-font-family: var(--uso-font-family);
    --uso-label-font-style: var(--uso-font-style);

    --uso-label-padding-top: 3px;
    --uso-label-padding-bottom: 3px;
    --uso-label-padding-left: 0;
    --uso-label-padding-right: 3px;

    --uso-label-margin-top: 0;
    --uso-label-margin-bottom: 0;
    --uso-label-margin-left: 0;
    --uso-label-margin-right: 0;

}

.uso-label {

    font-size: var(--uso-label-font-size);
    -unity-font: var(--uso-label-font-family);
    -unity-font-style: var(--uso-label-font-style);

    padding-top: var(--uso-label-padding-top);
    padding-bottom: var(--uso-label-padding-bottom);
    padding-left: var(--uso-label-padding-left);
    padding-right: var(--uso-label-padding-right);

    margin-top: var(--uso-label-margin-top);
    margin-bottom: var(--uso-label-margin-bottom);
    margin-left: var(--uso-label-margin-left);
    margin-right: var(--uso-label-margin-right);

}

.uso-label--header {
    -unity-font-style: var(--uso-header-font-style);
    font-size: var(--uso-header-font-size);
    -unity-font: var(--uso-header-font-family);

    padding-top: var(--uso-header-padding-top);
    padding-bottom: var(--uso-header-padding-bottom);
    padding-left: var(--uso-header-padding-left);
    padding-right: var(--uso-header-padding-right);

    margin-top: var(--uso-header-margin-top);
    margin-bottom: var(--uso-header-margin-bottom);
    margin-left: var(--uso-header-margin-left);
    margin-right: var(--uso-header-margin-right);

    border-top-color: var(--uso-header-border-top-color);
    border-left-color: var(--uso-header-border-left-color);
    border-bottom-color: var(--uso-header-border-bottom-color);
    border-right-color: var(--uso-header-border-right-color);

    border-bottom-left-radius: var(--uso-header-border-top-left-radius);
    border-bottom-right-radius: var(--uso-header-border-top-right-radius);
    border-top-left-radius: var(--uso-header-border-bottom-left-radius);
    border-top-right-radius: var(--uso-header-border-bottom-right-radius);

    border-top-width: var(--uso-header-border-top-width);
    border-bottom-width: var(--uso-header-border-bottom-width);
    border-left-width: var(--uso-header-border-left-width);
    border-right-width: var(--uso-header-border-right-width);

    background-color: var(--uso-header-background-color);
}

.uso-label--subheader {
    -unity-font-style: var(--uso-subheader-font-style);
    font-size: var(--uso-subheader-font-size);
    -unity-font: var(--uso-subheader-font-family);

    padding-top: var(--uso-subheader-padding-top);
    padding-bottom: var(--uso-subheader-padding-bottom);
    padding-left: var(--uso-subheader-padding-left);
    padding-right: var(--uso-subheader-padding-right);

    margin-top: var(--uso-subheader-margin-top);
    margin-bottom: var(--uso-subheader-margin-bottom);
    margin-left: var(--uso-subheader-margin-left);
    margin-right: var(--uso-subheader-margin-right);

    border-top-color: var(--uso-subheader-border-top-color);
    border-left-color: var(--uso-subheader-border-left-color);
    border-bottom-color: var(--uso-subheader-border-bottom-color);
    border-right-color: var(--uso-subheader-border-right-color);

    border-bottom-left-radius: var(--uso-subheader-border-top-left-radius);
    border-bottom-right-radius: var(--uso-subheader-border-top-right-radius);
    border-top-left-radius: var(--uso-subheader-border-bottom-left-radius);
    border-top-right-radius: var(--uso-subheader-border-bottom-right-radius);

    border-top-width: var(--uso-subheader-border-top-width);
    border-bottom-width: var(--uso-subheader-border-bottom-width);
    border-left-width: var(--uso-subheader-border-left-width);
    border-right-width: var(--uso-subheader-border-right-width);

    background-color: var(--uso-subheader-background-color);
}

.uso-label--title {
    -unity-font-style: bold;
    font-size: var(--uso-title-font-size);
    -unity-font: var(--uso-title-font-family);

    padding-top: var(--uso-title-padding-top);
    padding-bottom: var(--uso-title-padding-bottom);
    padding-left: var(--uso-title-padding-left);
    padding-right: var(--uso-title-padding-right);

    margin-top: var(--uso-title-margin-top);
    margin-bottom: var(--uso-title-margin-bottom);
    margin-left: var(--uso-title-margin-left);
    margin-right: var(--uso-title-margin-right);

    border-top-color: var(--uso-title-border-top-color);
    border-left-color: var(--uso-title-border-left-color);
    border-bottom-color: var(--uso-title-border-bottom-color);
    border-right-color: var(--uso-title-border-right-color);

    border-bottom-left-radius: var(--uso-title-border-top-left-radius);
    border-bottom-right-radius: var(--uso-title-border-top-right-radius);
    border-top-left-radius: var(--uso-title-border-bottom-left-radius);
    border-top-right-radius: var(--uso-title-border-bottom-right-radius);

    border-top-width: var(--uso-title-border-top-width);
    border-bottom-width: var(--uso-title-border-bottom-width);
    border-left-width: var(--uso-title-border-left-width);
    border-right-width: var(--uso-title-border-right-width);

    background-color: var(--uso-title-background-color);
}

