    margin-bottom: var(--uso-subtitle-margin-bottom);
    margin-left: var(--uso-subtitle-margin-left);
    margin-right: var(--uso-subtitle-margin-right);

    border-top-color: var(--uso-subtitle-border-top-color);
    border-left-color: var(--uso-subtitle-border-left-color);
    border-bottom-color: var(--uso-subtitle-border-bottom-color);
    border-right-color: var(--uso-subtitle-border-right-color);

